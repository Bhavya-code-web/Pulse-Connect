# Copy to .env and edit.  DB_CLIENT=mysql (default) or sqlite (zero-install demo).
PORT=3000
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=MyNewPass@123
DB_NAME=pulseconnect
# Only used when DB_CLIENT=sqlite
SQLITE_FILE=./database/pulseconnect.sqlite
# Leave empty when frontend and API are served together (same origin).
CORS_ORIGIN=http://127.0.0.1:5500
# Set a long random value to enable GET /api/emergency-requests (header: x-admin-token).
ADMIN_TOKEN=
# true when running behind a reverse proxy (uses X-Forwarded-For for rate limiting)
TRUST_PROXY=false
